{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "codex/release-1-bootstrap",
  "neverConnectToCloud": true,
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist", "{projectRoot}/build"]
    },
    "typecheck": {
      "cache": true,
      "dependsOn": ["^typecheck"]
    }
  }
}
