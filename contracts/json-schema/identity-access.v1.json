{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "module": "identity-access",
  "schemas": {
    "AccountProfileProjection": {
      "$id": "AccountProfileProjection.v1",
      "additionalProperties": false,
      "properties": {
        "authority": {
          "items": {
            "type": "string"
          },
          "maxItems": 0,
          "type": "array"
        },
        "displayName": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "verifiedEmail": {
          "maxLength": 320,
          "minLength": 3,
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "displayName",
        "verifiedEmail",
        "authority",
        "version"
      ],
      "type": "object"
    },
    "AccountProfileRequest": {
      "$id": "AccountProfileRequest.v1",
      "additionalProperties": false,
      "properties": {
        "audience": {
          "const": "self",
          "type": "string"
        }
      },
      "required": [
        "audience"
      ],
      "type": "object"
    },
    "AccountSecurityHistoryList": {
      "$id": "AccountSecurityHistoryList.v1",
      "additionalProperties": false,
      "properties": {
        "history": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "approximateLocation": {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              "device": {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              "id": {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              "kind": {
                "anyOf": [
                  {
                    "const": "accepted_sign_in",
                    "type": "string"
                  },
                  {
                    "const": "clerk_reverification",
                    "type": "string"
                  },
                  {
                    "const": "account_suspension",
                    "type": "string"
                  }
                ]
              },
              "occurredAt": {
                "maxLength": 35,
                "minLength": 20,
                "type": "string"
              },
              "suspensionStatus": {
                "anyOf": [
                  {
                    "const": "imposed",
                    "type": "string"
                  },
                  {
                    "const": "reinstated",
                    "type": "string"
                  },
                  {
                    "const": "expired",
                    "type": "string"
                  }
                ]
              }
            },
            "required": [
              "id",
              "kind",
              "occurredAt"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "history"
      ],
      "type": "object"
    },
    "AccountSecurityHistoryRequest": {
      "$id": "AccountSecurityHistoryRequest.v1",
      "additionalProperties": false,
      "properties": {
        "audience": {
          "const": "self",
          "type": "string"
        }
      },
      "required": [
        "audience"
      ],
      "type": "object"
    },
    "ChangeDisplayNameRequest": {
      "$id": "ChangeDisplayNameRequest.v1",
      "additionalProperties": false,
      "properties": {
        "displayName": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "expectedVersion": {
          "minimum": 1,
          "type": "integer"
        },
        "idempotencyKey": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "displayName",
        "expectedVersion",
        "idempotencyKey"
      ],
      "type": "object"
    },
    "CreateDocketSessionRequest": {
      "$id": "CreateDocketSessionRequest.v1",
      "additionalProperties": false,
      "properties": {
        "idempotencyKey": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "idempotencyKey"
      ],
      "type": "object"
    },
    "DocketSessionList": {
      "$id": "DocketSessionList.v1",
      "additionalProperties": false,
      "properties": {
        "sessions": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "approximateLocation": {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              "createdAt": {
                "maxLength": 35,
                "minLength": 20,
                "type": "string"
              },
              "device": {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              "expiresAt": {
                "maxLength": 35,
                "minLength": 20,
                "type": "string"
              },
              "id": {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              "inactivityExpiresAt": {
                "maxLength": 35,
                "minLength": 20,
                "type": "string"
              },
              "lastActivityAt": {
                "maxLength": 35,
                "minLength": 20,
                "type": "string"
              },
              "privilegedActivatedAt": {
                "maxLength": 35,
                "minLength": 20,
                "type": "string"
              },
              "sessionClass": {
                "anyOf": [
                  {
                    "const": "ordinary",
                    "type": "string"
                  },
                  {
                    "const": "privileged",
                    "type": "string"
                  }
                ]
              },
              "status": {
                "anyOf": [
                  {
                    "const": "active",
                    "type": "string"
                  },
                  {
                    "const": "expired",
                    "type": "string"
                  },
                  {
                    "const": "revoked",
                    "type": "string"
                  }
                ]
              },
              "version": {
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "id",
              "sessionClass",
              "device",
              "approximateLocation",
              "status",
              "version",
              "createdAt",
              "lastActivityAt",
              "inactivityExpiresAt",
              "expiresAt"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "sessions"
      ],
      "type": "object"
    },
    "DocketSessionResult": {
      "$id": "DocketSessionResult.v1",
      "additionalProperties": false,
      "properties": {
        "account": {
          "$id": "AccountProfileProjection.v1",
          "additionalProperties": false,
          "properties": {
            "authority": {
              "items": {
                "type": "string"
              },
              "maxItems": 0,
              "type": "array"
            },
            "displayName": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "id": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "verifiedEmail": {
              "maxLength": 320,
              "minLength": 3,
              "type": "string"
            },
            "version": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "id",
            "displayName",
            "verifiedEmail",
            "authority",
            "version"
          ],
          "type": "object"
        },
        "session": {
          "additionalProperties": false,
          "properties": {
            "approximateLocation": {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            "createdAt": {
              "maxLength": 35,
              "minLength": 20,
              "type": "string"
            },
            "device": {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            "expiresAt": {
              "maxLength": 35,
              "minLength": 20,
              "type": "string"
            },
            "id": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "inactivityExpiresAt": {
              "maxLength": 35,
              "minLength": 20,
              "type": "string"
            },
            "lastActivityAt": {
              "maxLength": 35,
              "minLength": 20,
              "type": "string"
            },
            "privilegedActivatedAt": {
              "maxLength": 35,
              "minLength": 20,
              "type": "string"
            },
            "sessionClass": {
              "anyOf": [
                {
                  "const": "ordinary",
                  "type": "string"
                },
                {
                  "const": "privileged",
                  "type": "string"
                }
              ]
            },
            "status": {
              "anyOf": [
                {
                  "const": "active",
                  "type": "string"
                },
                {
                  "const": "expired",
                  "type": "string"
                },
                {
                  "const": "revoked",
                  "type": "string"
                }
              ]
            },
            "version": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "id",
            "sessionClass",
            "device",
            "approximateLocation",
            "status",
            "version",
            "createdAt",
            "lastActivityAt",
            "inactivityExpiresAt",
            "expiresAt"
          ],
          "type": "object"
        }
      },
      "required": [
        "account",
        "session"
      ],
      "type": "object"
    },
    "IdentitySessionProjection": {
      "$id": "IdentitySessionProjection.v1",
      "additionalProperties": false,
      "properties": {
        "audience": {
          "const": "self",
          "type": "string"
        },
        "authenticated": {
          "const": true,
          "type": "boolean"
        },
        "userId": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "authenticated",
        "userId",
        "audience"
      ],
      "type": "object"
    },
    "IdentitySessionRequest": {
      "$id": "IdentitySessionRequest.v1",
      "additionalProperties": false,
      "properties": {
        "audience": {
          "const": "self",
          "type": "string"
        }
      },
      "required": [
        "audience"
      ],
      "type": "object"
    },
    "ListDocketSessionsRequest": {
      "$id": "ListDocketSessionsRequest.v1",
      "additionalProperties": false,
      "properties": {
        "audience": {
          "const": "self",
          "type": "string"
        }
      },
      "required": [
        "audience"
      ],
      "type": "object"
    },
    "RevokeAllDocketSessionsRequest": {
      "$id": "RevokeAllDocketSessionsRequest.v1",
      "additionalProperties": false,
      "properties": {
        "idempotencyKey": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "idempotencyKey"
      ],
      "type": "object"
    },
    "RevokeDocketSessionRequest": {
      "$id": "RevokeDocketSessionRequest.v1",
      "additionalProperties": false,
      "properties": {
        "expectedVersion": {
          "minimum": 1,
          "type": "integer"
        },
        "idempotencyKey": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "sessionId": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "sessionId",
        "expectedVersion",
        "idempotencyKey"
      ],
      "type": "object"
    },
    "StableErrorEnvelope": {
      "$id": "StableErrorEnvelope.v1",
      "additionalProperties": false,
      "properties": {
        "code": {
          "anyOf": [
            {
              "const": "AUTHENTICATION_REQUIRED",
              "type": "string"
            },
            {
              "const": "AUTHORITY_STALE",
              "type": "string"
            },
            {
              "const": "DISPLAY_NAME_CHANGE_TOO_SOON",
              "type": "string"
            },
            {
              "const": "REQUEST_INVALID",
              "type": "string"
            },
            {
              "const": "RESPONSE_INVALID",
              "type": "string"
            },
            {
              "const": "IDENTITY_INVALID",
              "type": "string"
            },
            {
              "const": "SESSION_EXPIRED",
              "type": "string"
            },
            {
              "const": "SESSION_LIMIT_REACHED",
              "type": "string"
            },
            {
              "const": "FIXED_IDENTITY_FORBIDDEN",
              "type": "string"
            }
          ]
        },
        "fieldIssues": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "message": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "message"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "message": {
          "minLength": 1,
          "type": "string"
        },
        "requestId": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "requestId"
      ],
      "type": "object"
    }
  },
  "version": "1.0.0"
}
