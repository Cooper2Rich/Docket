          "message": {
            "minLength": 1,
            "type": "string"
          },
          "requestId": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ],
        "type": "object"
      }
    }
